[Unit]
Description=Run stonks sell every day shortly after the US market opens

[Timer]
# 06:35 Pacific: five minutes after the 06:30 open, correct across DST changes.
# The command checks Robinhood's calendar and does nothing on weekends and holidays.
OnCalendar=*-*-* 06:35:00 America/Los_Angeles
# Never catch up a run missed while the box was off.
Persistent=false

[Install]
WantedBy=timers.target
